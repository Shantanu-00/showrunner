# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Use the Gemini Enterprise Agent Platform (ex-Vertex AI) path from ADK.
# NOTE: this replaced GOOGLE_GENAI_USE_VERTEXAI in 2026.
GOOGLE_GENAI_USE_ENTERPRISE=True
# Local dev only — on Cloud Run / Agent Runtime use the attached service account, never key files.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Models (verified current 2026-08-24 — see docs/research/)
GEMINI_API_KEY=your-gemini-api-key
MODEL_CLASSIFIER=gemini-3.5-flash-lite        # high-volume per-photo curation (free tier + Batch)
MODEL_DIRECTOR=gemini-3.7-flash               # Story Director / Reel Director reasoning
MODEL_IMAGE_EDIT=gemini-3.1-flash-image       # Nano Banana 2 (Imagen is shut down)
MODEL_MUSIC=lyria-3-clip-preview              # 30s soundtrack clips ($0.04/clip)
MODEL_VIDEO_GEN=veo-3.1-fast-generate-preview # hero intro clips ($0.10/s)
MODEL_TASTE_MEMO=gemma-4-26b-a4b-it           # private taste-memo writer (spec 07 §2) — free tier, off-critical-path by design

# Agent Runtime observability (set at deploy)
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Server & Storage
PORT=8080
ENVIRONMENT=development
RAW_MEDIA_BUCKET=showrunner-raw-media
DERIVED_MEDIA_BUCKET=showrunner-derived-media   # thumbs/renders — separate bucket avoids Eventarc retrigger loops
CURATED_REELS_BUCKET=showrunner-curated-reels
CLASSIFY_QUEUE=classify-queue                      # Cloud Tasks, rate-limited
FACE_QUEUE=face-queue
SAFETY_QUEUE=safety-queue
VIDEO_PREP_QUEUE=video-prep-queue
PRIORITY_QUEUE=priority-queue                      # bounty submissions jump the classify line
RENDERS_QUEUE=renders-queue

# Task targets. Empty until the B2 workers deploy — intake logs a skipped dispatch instead of
# queueing work nothing can consume, so the fan-out code is complete before the workers exist.
WORKER_CURATE_URL=
WORKER_FACE_URL=
WORKER_SAFETY_URL=
WORKER_VIDEO_PREP_URL=

# Identities (written by deploy/sa.sh). SIGNER_SA_EMAIL is the SA whose IAM signBlob mints
# signed URLs — this is why no service-account key file exists anywhere in this project.
SIGNER_SA_EMAIL=sa-api@your-gcp-project-id.iam.gserviceaccount.com
TASKS_SA_EMAIL=sa-tasks@your-gcp-project-id.iam.gserviceaccount.com

# Product limits (spec 01 §3, spec 02 §3, spec 04 §2, spec 11 §1)
UPLOAD_RATE_LIMIT_PER_HOUR=300
CLAIM_REVIEW_THRESHOLD=8
DEFAULT_PUBLIC_FLOOR=0.45
MAX_CONCURRENT_LIVE_EVENTS=3
PUBLIC_EVENT_MAX_LIVE_MINUTES=60
PUBLIC_EVENT_COST_CEILING_USD=3.0

# Browser origins allowed to call the API (comma-separated; bucket CORS is set in deploy/buckets.sh)
ALLOWED_ORIGINS=http://localhost:3000

# Model Armor (text-surface guardrails)
MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/us/templates/showrunner-guard

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id
NEXT_PUBLIC_DEFAULT_EVENT_ID=pune_wedding_2026
# Web SDK config for anonymous guest sign-in — written by deploy/bootstrap.sh.
# The API key is a public client identifier, not a secret; Firestore rules are the boundary.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ORIGIN=                            # extra origin for bucket CORS, if not *.web.app
