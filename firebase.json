{
  "hosting": {
    "public": "frontend/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/join", "destination": "/join.html" },
      { "source": "/join/**", "destination": "/join/global_demo.html" },
      { "source": "/kiosk/**", "destination": "/kiosk/global_demo.html" },
      { "source": "/events/**/claim", "destination": "/events/global_demo/claim.html" },
      { "source": "/how-it-works", "destination": "/how-it-works.html" },
      { "source": "/judge", "destination": "/judge.html" },
      { "source": "/host", "destination": "/host.html" },
      { "source": "/host/**", "destination": "/host/global_demo.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true }
  }
}
